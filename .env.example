# Copy to .env.local (never commit real values). Placeholders only.
MONGODB_URI=
MONGODB_DB=mithila_milan

# Public origin of the deployed app. REQUIRED in production: used to build password-reset links
# (never derived from the Host header) .
APP_URL=http://localhost:3000
# Extra allowed browser origins for state-changing requests (comma separated), optional.
APP_ORIGINS=

# Google sign-in. The same OAuth client ID is used by the server (audience check) and the browser button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin accounts are NOT configured here. Provision them with scripts/provision-admin.ts
# (ADMIN_EMAIL / ADMIN_PASSWORD are read once from the shell environment, hashed, and discarded).
